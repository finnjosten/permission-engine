{
    "name": "finnjosten/permission-engine",
    "description": "RBAC permission system with wildcards and deny rules for Laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Finn\\PermissionEngine\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Finn\\PermissionEngine\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/auth": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Finn\\PermissionEngine\\PermissionEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
